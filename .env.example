# 复制为 .env 并 chmod 600；不会执行 shell 表达式，不支持 $变量展开。
# 相对路径以项目根目录为基准。不要提交 .env 或真实密钥。
MODEL_PATH=/path/to/Nvidia-Qwen3.8-27B-NVFP4
VLLM_API_KEY=replace-with-a-random-secret
SERVED_MODEL_NAME=Qwen3.8-27B
# 默认仅本机监听。Docker New API 接入时需明确调整监听地址和防火墙。
HOST=127.0.0.1
PORT=8000
GPU_IDS=0,1,2,3
TENSOR_PARALLEL_SIZE=4
MAX_MODEL_LEN=262144
GPU_MEMORY_UTILIZATION=0.92
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=4096
LONG_PREFILL_TOKEN_THRESHOLD=2048
MTP_TOKENS=3
FIREFLY_DIRECT=1
FIREFLY_AR=1
FIREFLY_AR_BACKEND=auto
CUDA_HOME=/usr/local/cuda-13.1
CC=gcc-13
CXX=g++-13
MAX_JOBS=2
